# GitHub username who owns the data repository
VITE_DATA_OWNER=your-github-username

# Name of the GitHub repository used for data storage
VITE_DATA_REPO=storeflow-data

# URL of the Netlify function for Mistral AI parsing
# Format: https://your-site.netlify.app/api/parse-products
VITE_NETLIFY_FUNCTION_URL=https://your-site.netlify.app/api/parse-products
